@{
    var section = ViewData["Section"] as string;
}

<!-- Rapor Yönetimi Butonları ve Liste Alanı -->
<div class="report-management-container" data-section="@(section)">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Raporlar</h4>
        @if (User.IsInRole("Admin"))
        {
            <button class="btn btn-primary" id="open-add-report-modal-btn">
                <i class="fas fa-plus"></i> Yeni Rapor Ekle
            </button>
        }
    </div>
    <div id="report-list-container">
        <!-- Raporlar buraya AJAX ile yüklenecek -->
        <div id="no-report-message" class="alert alert-info d-none mt-3">Henüz rapor yok.</div>
    </div>
</div>

<!-- Rapor Ekle/Düzenle Modal -->
<div class="modal fade" id="addReportModal" tabindex="-1" role="dialog" aria-labelledby="addReportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addReportModalLabel">Yeni Rapor Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="add-report-form" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="report-section" name="Section" value="@(section)" />
                    <div class="form-group">
                        <label for="report-name">Rapor Adı</label>
                        <input type="text" class="form-control" id="report-name" name="ReportName" required>
                    </div>
                    <div class="form-group">
                        <label for="report-description">Açıklama</label>
                        <textarea class="form-control" id="report-description" name="Description" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="report-file">Rapor Dosyası (Opsiyonel)</label>
                        <input type="file" class="form-control-file" id="report-file" name="ReportFile">
                    </div>
                    <div id="add-report-error" class="alert alert-danger d-none"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="save-report-btn">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- Rapor Düzenle Modalı -->
<div class="modal fade" id="editReportModal" tabindex="-1" role="dialog" aria-labelledby="editReportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editReportModalLabel">Raporu Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="edit-report-form" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="edit-report-id" name="Id" />
                    <input type="hidden" id="edit-report-section" name="Section" value="@(section)" />
                    <div class="form-group">
                        <label for="edit-report-name">Rapor Adı</label>
                        <input type="text" class="form-control" id="edit-report-name" name="ReportName" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-report-description">Açıklama</label>
                        <textarea class="form-control" id="edit-report-description" name="Description" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="edit-report-file">Yeni Dosya (Opsiyonel)</label>
                        <input type="file" class="form-control-file" id="edit-report-file" name="ReportFile">
                        <div id="edit-current-file" class="mt-2"></div>
                    </div>
                    <div id="edit-report-error" class="alert alert-danger d-none"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="save-edit-report-btn">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- Rapor Silme Onay Modalı -->
<div class="modal fade" id="deleteReportModal" tabindex="-1" role="dialog" aria-labelledby="deleteReportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteReportModalLabel">Raporu Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p><strong id="report-to-delete-name"></strong> adlı raporu silmek istediğinizden emin misiniz?</p>
                <input type="hidden" id="report-to-delete-id">
            </div>
            <div class="modal-footer">
                 @Html.AntiForgeryToken()
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger" id="confirm-delete-report-btn">Sil</button>
            </div>
        </div>
    </div>
</div>