@model IEnumerable<WebPortal.Models.GenericReport>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="thead-light">
                <tr>
                    <th>Rapor Adı</th>
                    <th>Açıklama</th>
                    <th>Tarih</th>
                    <th>Dosya</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr id="report-row-@report.Id">
                        <td>@report.Title</td>
                        <td>@report.Content</td>
                        <td>@report.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(report.ReportType))
                            {
                                <a href="/uploads/reports/@report.ReportType" target="_blank" class="btn btn-sm btn-outline-primary">Görüntüle</a>
                            }
                            else
                            {
                                <span>Dosya Yok</span>
                            }
                        </td>
                        <td class="text-right">
                            @if (User.IsInRole("Admin"))
                            {
                                <button class="btn btn-primary btn-sm edit-report-btn me-2" data-id="@report.Id" data-name="@report.Title">
                                    <i class="fas fa-edit"></i> Düzenle
                                </button>
                                <button class="btn btn-danger btn-sm delete-report-btn" data-id="@report.Id" data-name="@report.Title">
                                    <i class="fas fa-trash"></i> Sil
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <p>Bu bölüme ait gösterilecek rapor bulunmamaktadır.</p>
    </div>
}
