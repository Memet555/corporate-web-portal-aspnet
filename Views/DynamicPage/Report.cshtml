@model WebPortal.Models.SidebarMenu
@{
    ViewData["Title"] = Model.Title;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Sayfa Başlığı ve Açıklama -->
            <div class="report-page-header">
                <h2 class="mb-2">@Model.Title</h2>
                <p>
                    @if (User.IsInRole("Admin"))
                    {
                        <text>Bu bölümde @Model.Title.ToLower() ile ilgili raporları yönetebilir, PDF, Excel, ZIP gibi dosyalar ekleyebilirsiniz.</text>
                    }
                    else
                    {
                        <text>Bu bölümde @Model.Title.ToLower() ile ilgili raporları görüntüleyebilirsiniz.</text>
                    }
                </p>
            </div>

            <!-- Raporlar Bölümü -->
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Raporlar</h5>
                        @if (User.IsInRole("Admin"))
                        {
                            <button class="btn btn-primary btn-sm" onclick="addReport()">
                                <i class="fas fa-plus me-1"></i>Yeni Rapor Ekle
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <!-- Rapor Listesi -->
                    <div id="report-list-container">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Bu bölüme ait gösterilecek rapor bulunamadı.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hızlı İstatistikler -->
            <div class="row mt-4 d-none">
                <div class="col-md-3">
                    <div class="card bg-primary text-white report-stats-card">
                        <div class="card-body text-center">
                            <i class="fas fa-file-alt fa-2x mb-2"></i>
                            <h4 class="mb-1">0</h4>
                            <small>Toplam Rapor</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white report-stats-card">
                        <div class="card-body text-center">
                            <i class="fas fa-check-circle fa-2x mb-2"></i>
                            <h4 class="mb-1">0</h4>
                            <small>Aktif Rapor</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white report-stats-card">
                        <div class="card-body text-center">
                            <i class="fas fa-calendar fa-2x mb-2"></i>
                            <h4 class="mb-1">0</h4>
                            <small>Bu Ay</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white report-stats-card">
                        <div class="card-body text-center">
                            <i class="fas fa-clock fa-2x mb-2"></i>
                            <h4 class="mb-1">0</h4>
                            <small>Bekleyen</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kurumsal Özellikler -->
            <div class="row mt-4 d-none">
                <div class="col-md-6">
                    <div class="card corporate-card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-chart-bar me-2"></i>Rapor Yönetimi
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm" onclick="exportReports()">
                                    <i class="fas fa-download me-1"></i>Dışa Aktar
                                </button>
                                <button class="btn btn-outline-info btn-sm" onclick="generateSummary()">
                                    <i class="fas fa-file-alt me-1"></i>Özet Rapor
                                </button>
                                <button class="btn btn-outline-success btn-sm" onclick="scheduleReport()">
                                    <i class="fas fa-calendar-plus me-1"></i>Zamanlı Rapor
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card corporate-card">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-users me-2"></i>Takım Yönetimi
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm" onclick="assignReports()">
                                    <i class="fas fa-user-plus me-1"></i>Görev Ata
                                </button>
                                <button class="btn btn-outline-warning btn-sm" onclick="setPermissions()">
                                    <i class="fas fa-shield-alt me-1"></i>Yetki Ayarla
                                </button>
                                <button class="btn btn-outline-info btn-sm" onclick="viewTeamActivity()">
                                    <i class="fas fa-chart-line me-1"></i>Takım Aktivitesi
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Rapor Ekleme Modal -->
<div class="modal fade" id="addReportModal" tabindex="-1" aria-labelledby="addReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addReportModalLabel">Yeni Rapor Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="add-report-form">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="reportTitle" class="form-label">Rapor Başlığı *</label>
                                <input type="text" class="form-control" id="reportTitle" name="Title" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="reportType" class="form-label">Rapor Türü</label>
                                <select class="form-select" id="reportType" name="ReportType">
                                    <option value="PDF">PDF</option>
                                    <option value="Excel">Excel</option>
                                    <option value="Word">Word</option>
                                    <option value="ZIP">ZIP</option>
                                    <option value="Diğer">Diğer</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="reportDescription" class="form-label">Açıklama</label>
                        <textarea class="form-control" id="reportDescription" name="Description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="reportSection" class="form-label">Bölüm</label>
                        <input type="text" class="form-control" id="reportSection" name="Section" value="@Model.Title" readonly>
                        <small class="form-text text-muted">Bu alan otomatik olarak doldurulur</small>
                    </div>
                    <div class="mb-3">
                        <label for="reportFile" class="form-label">Dosya *</label>
                        <input type="file" class="form-control" id="reportFile" name="ReportFile" required>
                        <small class="form-text text-muted">PDF, Excel, Word, ZIP dosyaları kabul edilir (Max: 10MB)</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" onclick="saveReport()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- Silme Onay Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Onay</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                Bu raporu silmek istediğinizden emin misiniz?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Sil</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Admin durumunu JavaScript'e aktar
    window.isUserAdmin = @(User.IsInRole("Admin") ? "true" : "false");
</script>
<script>
function addReport() {
    const modal = new bootstrap.Modal(document.getElementById('addReportModal'));
    modal.show();
}

function formatDateDDMMYYYY(value) {
    try {
        const d = new Date(value);
        if (isNaN(d.getTime()) || d.getFullYear() < 1900) return '';
        const dd = String(d.getDate()).padStart(2, '0');
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const yyyy = d.getFullYear();
        return `${dd}.${mm}.${yyyy}`;
    } catch { return ''; }
}

function saveReport() {
    const form = document.getElementById('add-report-form');
    const formData = new FormData(form);
    if (!formData.get('Title') || !formData.get('ReportFile')?.name) return;

    const reportFile = formData.get('ReportFile');
    if (reportFile.size > 10 * 1024 * 1024) { alert('Dosya boyutu 10MB\'dan büyük olamaz!'); return; }

    const allowedTypes = ['application/pdf','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/zip'];
    if (!allowedTypes.includes(reportFile.type) && reportFile.type !== '') { alert('Sadece PDF, Excel, Word ve ZIP dosyaları kabul edilir!'); return; }

    $.ajax({
        url: '/DynamicPage/CreateReport',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function(response) {
            if (response.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('addReportModal'));
                modal.hide();
                form.reset();
                document.getElementById('reportSection').value = '@Model.Title';
                updateReportList();
            } else {
                console.error('Save error:', response.message);
            }
        },
        error: function(xhr) { console.error('AJAX Error:', xhr.responseText); }
    });
}

function updateReportList() {
    const container = document.getElementById('report-list-container');
    const section = document.getElementById('reportSection')?.value || '@Model.Title';
    $.ajax({
        url: '/DynamicPage/GetReports',
        type: 'GET',
        data: { section: section },
        success: function(response) {
            if (response.success && response.reports && response.reports.length > 0) {
                let html = `
                    <div class="table-responsive report-table">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Rapor Adı</th>
                                    <th>Tür</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>`;
                response.reports.forEach(report => {
                    const dateText = formatDateDDMMYYYY(report.reportDate || report.createdAt);
                    html += `
                        <tr>
                            <td>${report.id}</td>
                            <td>${report.title}</td>
                            <td><span class="badge bg-secondary report-badge">${report.reportType}</span></td>
                            <td>${dateText}</td>
                            <td><span class="badge bg-success report-badge">${report.isActive ? 'Aktif' : 'Pasif'}</span></td>
                            <td class="report-actions">
                                <button class="btn btn-sm btn-outline-primary" onclick="viewReport(${report.id})">
                                    <i class="fas fa-eye me-1"></i>Görüntüle
                                </button>
                                ${window.isUserAdmin ? `<button class="btn btn-sm btn-outline-danger" onclick="deleteReport(${report.id})">
                                    <i class="fas fa-trash me-1"></i>Sil
                                </button>` : ''}
                            </td>
                        </tr>`;
                });
                html += `</tbody></table></div>`;
                container.innerHTML = html;
            } else {
                container.innerHTML = `
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Bu bölüme ait gösterilecek rapor bulunamadı.
                    </div>`;
            }
        },
        error: function() {
            container.innerHTML = `
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Raporlar yüklenirken bir hata oluştu.
                </div>`;
        }
    });
}

function viewReport(id) {
    window.open(`/DynamicPage/ViewReportFile?id=${id}`, '_blank');
}

let deleteTargetId = null;
function deleteReport(id) {
    deleteTargetId = id;
    const modal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
    document.getElementById('confirmDeleteBtn').onclick = performDelete;
    modal.show();
}

function performDelete() {
    if (!deleteTargetId) return;
    $.ajax({
        url: '/DynamicPage/DeleteReport',
        type: 'POST',
        data: { id: deleteTargetId },
        success: function(response) {
            const modal = bootstrap.Modal.getInstance(document.getElementById('confirmDeleteModal'));
            modal.hide();
            if (response.success) {
                updateReportList();
            } else {
                console.error('Delete error:', response.message);
            }
            deleteTargetId = null;
        },
        error: function(xhr) {
            console.error('Silme hatası:', xhr.responseText);
            deleteTargetId = null;
        }
    });
}

function exportReports() { alert('Dışa aktarma hazırlığı...'); }
function generateSummary() { alert('Özet rapor hazırlanıyor...'); }
function scheduleReport() { alert('Zamanlı rapor planlayın...'); }
function assignReports() { alert('Görev atama...'); }
function setPermissions() { alert('Yetki ayarları...'); }
function viewTeamActivity() { alert('Takım aktivitesi...'); }

// Sayfa yüklendiğinde rapor listesini güncelle
document.addEventListener('DOMContentLoaded', function() { updateReportList(); });
</script>
}
